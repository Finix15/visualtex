<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="VTPowerPointRibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="VisualTeX.Mac.PowerPoint.Tab"
           label="VisualTeX"
           insertAfterMso="TabInsert">
        <group id="VisualTeX.Mac.PowerPoint.Group" getLabel="VTPowerPointRibbonGetLabel">
          <button id="VisualTeX.Mac.PowerPoint.New"
                  getLabel="VTPowerPointRibbonGetLabel"
                  size="large"
                  image="VisualTeXIcon05"
                  onAction="VTPowerPointRibbonNew"/>
          <button id="VisualTeX.Mac.PowerPoint.Edit"
                  getLabel="VTPowerPointRibbonGetLabel"
                  size="large"
                  image="VisualTeXIcon07"
                  onAction="VTPowerPointRibbonEdit"/>
          <button id="VisualTeX.Mac.PowerPoint.Delete"
                  getLabel="VTPowerPointRibbonGetLabel"
                  size="normal"
                  imageMso="Delete"
                  onAction="VTPowerPointRibbonDelete"/>
          <dropDown id="VisualTeX.Mac.PowerPoint.FormulaFontSize"
                    getLabel="VTPowerPointRibbonGetLabel"
                    sizeString="200 pt"
                    getItemCount="VTPowerPointRibbonGetFormulaFontSizeItemCount"
                    getItemLabel="VTPowerPointRibbonGetFormulaFontSizeItemLabel"
                    getSelectedItemIndex="VTPowerPointRibbonGetFormulaFontSizeSelectedIndex"
                    onAction="VTPowerPointRibbonApplyFormulaFontSizePreset"
                    getScreentip="VTPowerPointRibbonGetScreentip"
                    getSupertip="VTPowerPointRibbonGetSupertip"/>
          <button id="VisualTeX.Mac.PowerPoint.Open"
                  getLabel="VTPowerPointRibbonGetLabel"
                  size="normal"
                  imageMso="FileOpen"
                  onAction="VTPowerPointRibbonOpen"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
