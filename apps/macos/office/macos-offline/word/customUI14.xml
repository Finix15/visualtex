<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="VTWordRibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="VisualTeX.Mac.Word.Tab"
           label="VisualTeX"
           insertAfterMso="TabInsert">
        <group id="VisualTeX.Mac.Word.Group" label="VisualTeX">
          <button id="VisualTeX.Mac.Word.Inline"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordImageInline"
                  onAction="VTWordRibbonInline"/>
          <button id="VisualTeX.Mac.Word.Display"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordImageDisplay"
                  onAction="VTWordRibbonDisplay"/>
          <button id="VisualTeX.Mac.Word.NativeInline"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordOmmlInline"
                  onAction="VTWordRibbonNativeInline"
                  getScreentip="VTWordRibbonGetScreentip"
                  getSupertip="VTWordRibbonGetSupertip"/>
          <button id="VisualTeX.Mac.Word.NativeDisplay"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordOmmlDisplay"
                  onAction="VTWordRibbonNativeDisplay"
                  getScreentip="VTWordRibbonGetScreentip"
                  getSupertip="VTWordRibbonGetSupertip"/>
          <button id="VisualTeX.Mac.Word.Edit"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordEditSelected"
                  onAction="VTWordRibbonEdit"/>

          <box id="VisualTeX.Mac.Word.ConvertRow" boxStyle="horizontal">
            <button id="VisualTeX.Mac.Word.ConvertNative"
                    getLabel="VTWordRibbonGetLabel"
                    image="VisualTeXWordConvertOmml"
                    onAction="VTWordRibbonConvertNative"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
            <button id="VisualTeX.Mac.Word.ConvertImage"
                    getLabel="VTWordRibbonGetLabel"
                    image="VisualTeXWordConvertImage"
                    onAction="VTWordRibbonConvertImage"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
          </box>
          <box id="VisualTeX.Mac.Word.NumberingRow" boxStyle="horizontal">
            <button id="VisualTeX.Mac.Word.Numbering"
                    getLabel="VTWordRibbonGetLabel"
                    image="VisualTeXWordUpdateNumbers"
                    onAction="VTWordRibbonNumbering"/>
            <menu id="VisualTeX.Mac.Word.NumberingFormat"
                  getLabel="VTWordRibbonGetLabel"
                  image="VisualTeXWordNumberingFormat"
                  getScreentip="VTWordRibbonGetScreentip"
                  getSupertip="VTWordRibbonGetSupertip">
              <button id="VisualTeX.Mac.Word.NumberingFormat.Sequence"
                      getLabel="VTWordRibbonGetLabel"
                      onAction="VTWordRibbonNumberingFormatSequence"/>
              <button id="VisualTeX.Mac.Word.NumberingFormat.ChapterDot"
                      getLabel="VTWordRibbonGetLabel"
                      onAction="VTWordRibbonNumberingFormatChapterDot"/>
              <button id="VisualTeX.Mac.Word.NumberingFormat.ChapterDash"
                      getLabel="VTWordRibbonGetLabel"
                      onAction="VTWordRibbonNumberingFormatChapterDash"/>
              <button id="VisualTeX.Mac.Word.NumberingFormat.SectionDot"
                      getLabel="VTWordRibbonGetLabel"
                      onAction="VTWordRibbonNumberingFormatSectionDot"/>
              <button id="VisualTeX.Mac.Word.NumberingFormat.SectionDash"
                      getLabel="VTWordRibbonGetLabel"
                      onAction="VTWordRibbonNumberingFormatSectionDash"/>
            </menu>
          </box>
          <box id="VisualTeX.Mac.Word.ReferenceRow" boxStyle="horizontal">
            <button id="VisualTeX.Mac.Word.CrossReference"
                    getLabel="VTWordRibbonGetLabel"
                    image="VisualTeXWordCrossReference"
                    onAction="VTWordRibbonCrossReference"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
            <button id="VisualTeX.Mac.Word.Open"
                    getLabel="VTWordRibbonGetLabel"
                    image="VisualTeXWordOpenApp"
                    onAction="VTWordRibbonOpen"/>
          </box>
          <button id="VisualTeX.Mac.Word.DocumentImport"
                  getLabel="VTWordRibbonGetLabel"
                  size="large"
                  image="VisualTeXWordDocumentImport"
                  onAction="VTWordRibbonDocumentImport"
                  getScreentip="VTWordRibbonGetScreentip"
                  getSupertip="VTWordRibbonGetSupertip"/>
        </group>

        <group id="VisualTeX.Mac.Word.RedrawGroup" getLabel="VTWordRibbonGetLabel">
          <menu id="VisualTeX.Mac.Word.RedrawSelection"
                getLabel="VTWordRibbonGetLabel"
                size="large"
                image="VisualTeXWordRedrawSelection"
                getScreentip="VTWordRibbonGetScreentip"
                getSupertip="VTWordRibbonGetSupertip">
            <button id="VisualTeX.Mac.Word.RedrawSelectionOmml"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRedrawSelectionOmml"/>
            <button id="VisualTeX.Mac.Word.RedrawSelectionImage"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRedrawSelectionImage"/>
            <menuSeparator id="VisualTeX.Mac.Word.RedrawSelectionRestoreSeparator"/>
            <button id="VisualTeX.Mac.Word.RestoreSelectionOmmlToLatex"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRestoreSelectionOmmlToLatex"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
            <button id="VisualTeX.Mac.Word.RestoreSelectionImageToLatex"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRestoreSelectionImageToLatex"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
          </menu>
          <menu id="VisualTeX.Mac.Word.RedrawDocument"
                getLabel="VTWordRibbonGetLabel"
                size="large"
                image="VisualTeXWordRedrawDocument"
                getScreentip="VTWordRibbonGetScreentip"
                getSupertip="VTWordRibbonGetSupertip">
            <button id="VisualTeX.Mac.Word.RedrawDocumentOmml"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRedrawDocumentOmml"/>
            <button id="VisualTeX.Mac.Word.RedrawDocumentImage"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRedrawDocumentImage"/>
            <menuSeparator id="VisualTeX.Mac.Word.RedrawDocumentRestoreSeparator"/>
            <button id="VisualTeX.Mac.Word.RestoreDocumentOmmlToLatex"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRestoreDocumentOmmlToLatex"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
            <button id="VisualTeX.Mac.Word.RestoreDocumentImageToLatex"
                    getLabel="VTWordRibbonGetLabel"
                    onAction="VTWordRibbonRestoreDocumentImageToLatex"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
          </menu>
        </group>

        <group id="VisualTeX.Mac.Word.FontSizeGroup" getLabel="VTWordRibbonGetLabel">
          <dropDown id="VisualTeX.Mac.Word.ImageFontSize"
                    getLabel="VTWordRibbonGetLabel"
                    sizeString="200 pt"
                    getItemCount="VTWordRibbonGetImageFontSizeItemCount"
                    getItemLabel="VTWordRibbonGetImageFontSizeItemLabel"
                    getSelectedItemIndex="VTWordRibbonGetImageFontSizeSelectedIndex"
                    onAction="VTWordRibbonApplyImageFontSizePreset"
                    getScreentip="VTWordRibbonGetScreentip"
                    getSupertip="VTWordRibbonGetSupertip"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
